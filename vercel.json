{
  "outputDirectory": "web",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/notiser",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/notiser",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/matt.js": {
      "maxDuration": 30
    }
  }
}
